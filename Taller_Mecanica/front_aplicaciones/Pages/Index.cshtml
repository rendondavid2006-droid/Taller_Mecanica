@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

@if (!Model.EstaLogueado)
{
    <div class="tm-login-page tm-login-pattern-workshop">
        <div class="tm-login-card">

            <h1 class="tm-login-title">
                Iniciar sesión
            </h1>

            <p class="tm-login-subtitle">
                Accede al sistema administrativo de Taller Mecánica
            </p>

            <form method="post">

                <div class="tm-login-field">
                    <label for="Nombre_Usuario">
                        Usuario
                    </label>

                    <input asp-for="@Model.Nombre_Usuario"
                           placeholder="Ingrese su usuario"
                           autocomplete="username" />
                </div>

                <div class="tm-login-field">
                    <label for="Contraseña">
                        Contraseña
                    </label>

                    <input type="password"
                           asp-for="@Model.Contraseña"
                           placeholder="Ingrese su contraseña"
                           autocomplete="current-password" />
                </div>

                <div class="tm-login-actions">
                    <input type="submit"
                           value="Limpiar"
                           asp-page-handler="BtClean"
                           class="btn btn-secondary tm-btn tm-btn-neutral" />

                     
                    <input type="submit"
                           value="Entrar"
                           asp-page-handler="BtEnter"
                           class="btn btn-primary tm-btn tm-btn-primary" />
                </div>

            </form>

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync(
                    "/Pages/Emergentes/Mensajes.cshtml"
                )
            }

        </div>
    </div>
}
else
{
    <div class="tm-home-card">

        <h1 class="tm-page-heading">
            Bienvenido
        </h1>

        <h4>
            @Model.UsuarioActual
        </h4>

        @if (!string.IsNullOrEmpty(Model.RolActual))
        {
            <p class="tm-page-subtitle">
                Rol: @Model.RolActual
            </p>
        }

        <form method="post" class="mt-4">
            <input type="submit"
                   value="Cerrar sesión"
                   asp-page-handler="BtClose"
                   class="btn btn-danger tm-btn tm-btn-danger" />
        </form>

    </div>
}
