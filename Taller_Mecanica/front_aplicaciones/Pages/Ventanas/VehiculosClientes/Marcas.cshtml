@page
@model MarcasModel
@{
    ViewData["Title"] = "Marcas";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Marcas</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flNombre" 
            placeholder="Nombre Marca"
            asp-for="@Model.Filtro!.Nombre_Marca"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
          @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Marca</h3>
                
                <label>
                    Nombre Marca
                </label>
                <input id="nmNombre_Marca"
                    asp-for="@Model.Actual!.Nombre_Marca" />
                <br/>

                <label>
                    Pais Origen
                </label>
                <input id="nmPais_Origen"
                    asp-for="@Model.Actual!.Pais_Origen" />
                <br />

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                    asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                    asp-for="@Model.Actual!.Estado" />
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Nombre_Marca
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre Marca</th>
                        <th>Pais Origen</th>
                        <th>Descripcion</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Nombre_Marca</td>
                                <td>@elemento.Pais_Origen</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.Estado</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>