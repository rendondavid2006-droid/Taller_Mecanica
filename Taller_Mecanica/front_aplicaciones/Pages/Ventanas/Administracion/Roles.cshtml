@page
@model RolesModel
@{
    ViewData["Title"] = "Roles";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Roles</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flNombre" 
            placeholder="Nombre"
            asp-for="@Model.Filtro!.Nombre_Rol"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
          @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Roles</h3>
                
                <label>
                    Nombre Rol
                </label>
                <input id="nmNombre_Rol"
                    asp-for="@Model.Actual!.Nombre_Rol" />
                <br/>

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                    asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Nivel de Acceso
                </label>
                <input id="nmNivelAcceso"
                    asp-for="@Model.Actual!.Nivel_Acceso" />
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                    asp-for="@Model.Actual!.Estado" />
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Nombre_Rol,
                        @Model.Actual!.Descripcion,
                        @Model.Actual!.Nivel_Acceso
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre Rol</th>
                        <th>Descripcion</th>
                        <th>Nivel de Acceso</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Nombre_Rol</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.Nivel_Acceso</td>
                                <td>@elemento.Estado</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>