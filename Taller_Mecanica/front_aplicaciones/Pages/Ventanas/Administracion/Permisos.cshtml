@page
@model PermisosModel
@{
    ViewData["Title"] = "Permisos";
}

<form method="post" enctype="multipart/form-data">
    <div class="text-center">
        <h1 class="display-4">Permisos</h1>

        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />

        <input type="submit"
               value="Nuevo"
               class="btn btn-secondary"
               asp-page-handler="BtNuevo" />

        @if (Model.Formulario)
        {
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        }

        <input id="flNombre"
               placeholder="Nombre Permiso"
               asp-for="@Model.Filtro!.Nombre_Permiso" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                   type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Permiso</h3>

                <label>Rol</label>
                <select id="nmRol"
                        class="form-control"
                        asp-for="@Model.Actual!.Rol">
                    <option value="0">Seleccione un rol</option>
                    @foreach (var rol in Model.Roles)
                    {
                        if (Model.Actual?.Rol == rol.Id)
                        {
                            <option value="@rol.Id" selected>@rol.Nombre_Rol</option>
                        }
                        else
                        {
                            <option value="@rol.Id">@rol.Nombre_Rol</option>
                        }
                    }
                </select>
                <br />

                <label>Nombre Permiso</label>
                <input id="nmNombrePermiso"
                       asp-for="@Model.Actual!.Nombre_Permiso" />
                <br />

                <label>Descripcion</label>
                <input id="nmDescripcion"
                       asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>Estado</label>
                <input id="nmEstado"
                       asp-for="@Model.Actual!.Estado" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>
                    <h4>¿Desea borrar la entidad...?</h4>
                    <h6>
                        @Model.Actual!.Nombre_Permiso,
                        @Model.Actual!.Descripcion
                    </h6>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Rol</th>
                        <th>Nombre Permiso</th>
                        <th>Descripcion</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            var rol = Model.Roles.FirstOrDefault(x => x.Id == elemento.Rol);
                            <tr>
                                <td>@(rol?.Nombre_Rol ?? $"Rol #{elemento.Rol}")</td>
                                <td>@elemento.Nombre_Permiso</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.Estado</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
