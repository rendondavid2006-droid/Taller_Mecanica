@page
@model Detalles_Ordenes_ServiciosModel

@{
    ViewData["Title"] = "Detalles de Servicios por Orden";
}

<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">

        <h1 class="display-4">
            Detalles de Servicios por Orden
        </h1>


        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />


        <input type="submit"
               value="Nuevo"
               class="btn btn-secondary"
               asp-page-handler="BtNuevo" />


        @if (Model.Formulario)
        {
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        }


        <input id="flNombre"
               placeholder="Empleado de la orden"
               asp-for="@Model.Filtro!._Orden!._Empleado!.Nombre" />


        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync(
                "/Pages/Emergentes/Mensajes.cshtml"
            )
        }


        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                   type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }



        @if (Model.Formulario)
        {
            <div>

                <h3>
                    Detalle de Servicio
                </h3>



                <label>
                    Orden
                </label>

                <select id="nmOrden"
                        class="form-control"
                        asp-for="@Model.Actual!.Orden">

                    <option value="0">
                        Seleccione una orden
                    </option>

                    @foreach (var orden in Model.Ordenes)
                    {
                        if (Model.Actual?.Orden == orden.Id)
                        {
                            <option value="@orden.Id"
                                    selected>
                                @orden._Cita?._Cliente?.Documento - @orden._Cita?._Cliente?.Nombre @orden._Cita?._Cliente?.Apellido - @orden._Vehiculo?.Placa
                            </option>
                        }
                        else
                        {
                            <option value="@orden.Id">
                                @orden._Cita?._Cliente?.Documento - @orden._Cita?._Cliente?.Nombre @orden._Cita?._Cliente?.Apellido - @orden._Vehiculo?.Placa
                            </option>
                        }
                    }

                </select>

                <br />


  

                <label>
                    Servicio
                </label>

                <select id="nmServicio"
                        class="form-control"
                        asp-for="@Model.Actual!.Servicio">

                    <option value="0">
                        Seleccione un servicio
                    </option>

                    @foreach (var servicio in Model.Servicios)
                    {
  
                        if (servicio.Estado ||
                            Model.Actual?.Servicio == servicio.Id)
                        {
                            if (Model.Actual?.Servicio == servicio.Id)
                            {
                                <option value="@servicio.Id"
                                        selected>
                                    @servicio.Nombre_Servicio
                                </option>
                            }
                            else
                            {
                                <option value="@servicio.Id">
                                    @servicio.Nombre_Servicio
                                </option>
                            }
                        }
                    }

                </select>

                <br />



                <label>
                    Cantidad
                </label>

                <input id="nmCantidad"
                       type="number"
                       min="1"
                       class="form-control"
                       asp-for="@Model.Actual!.Cantidad"
                       oninput="calcularSubtotalServicio()" />

                <br />


                <label>
                    Precio Unitario
                </label>

                <input id="nmPrecio_Unitario"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control"
                       asp-for="@Model.Actual!.Precio_Unitario"
                       oninput="calcularSubtotalServicio()" />

                <br />



                <label>
                    Subtotal
                </label>

                <input id="nmSubtotal"
                       type="number"
                       min="0"
                       step="0.01"
                       class="form-control"
                       asp-for="@Model.Actual!.Subtotal"
                       readonly />

                <br />

            </div>
        }


        @if (Model.Borrar)
        {
            <div class="popup">

                <div class="pp_del_inner">

                    <h3>
                        Mensaje
                    </h3>


                    <h4>
                        ¿Desea borrar el detalle de servicio?
                    </h4>


                    <h6>
                        Detalle de servicio seleccionado
                    </h6>


                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-danger"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }


        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default"
                 style="overflow-x:auto">

                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>

                        <th>
                            Orden
                        </th>

                        <th>
                            Servicio
                        </th>

                        <th>
                            Cantidad
                        </th>

                        <th>
                            Precio Unitario
                        </th>

                        <th>
                            Subtotal
                        </th>

                        <th>
                            Acción
                        </th>

                    </tr>


                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            var orden =
                                Model.Ordenes
                                    .FirstOrDefault(
                                        x =>
                                            x.Id ==
                                            elemento.Orden);


                            var servicio =
                                Model.Servicios
                                    .FirstOrDefault(
                                        x =>
                                            x.Id ==
                                            elemento.Servicio);


                            <tr>

                                <td>
                                    @if (orden != null)
                                    {
                                        <span>
                                            @orden._Cita?._Cliente?.Documento - @orden._Cita?._Cliente?.Nombre @orden._Cita?._Cliente?.Apellido - @orden._Vehiculo?.Placa
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Orden no disponible
                                        </span>
                                    }
                                </td>


                                <td>
                                    @if (servicio != null)
                                    {
                                        @servicio.Nombre_Servicio
                                    }
                                    else
                                    {
                                        <span>
                                            Servicio #@elemento.Servicio
                                        </span>
                                    }
                                </td>


                                <td>
                                    @elemento.Cantidad
                                </td>


                                <td>
                                    @elemento.Precio_Unitario
                                </td>


                                <td>
                                    @elemento.Subtotal
                                </td>


                                <td>

                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />


                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-danger"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />

                                </td>

                            </tr>
                        }
                    }

                </table>

            </div>
        }

    </div>

</form>
<script>
    function calcularSubtotalServicio() {
        const cantidad = parseFloat(document.getElementById("nmCantidad")?.value || "0");
        const precio = parseFloat(document.getElementById("nmPrecio_Unitario")?.value || "0");
        const subtotal = document.getElementById("nmSubtotal");
        if (subtotal) subtotal.value = (cantidad * precio).toFixed(2);
    }
</script>
