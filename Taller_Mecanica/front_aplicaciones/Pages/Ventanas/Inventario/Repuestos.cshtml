@page
@model RepuestosModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Repuestos";

    var rolId =
        ViewContext.HttpContext.Session.GetString("RolId");
}


<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">

        <h1 class="display-4">
            Repuestos
        </h1>




        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />


        @if (rolId == "1")
        {
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
        }




        @if (rolId == "1" &&
             Model.Formulario)
        {
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        }


        <input id="flNombre"
               placeholder="Nombre"
               asp-for="@Model.Filtro!.Nombre_Repuesto" />


        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync(
                "/Pages/Emergentes/Mensajes.cshtml"
            )
        }



        @if ((Model.Formulario || Model.Borrar) &&
             rolId == "1")
        {
            <input id="nmId"
                   type="hidden"
                   asp-for="@Model.Actual!.Id" />

            <input type="hidden"
                   asp-for="@Model.Actual!.Imagen" />
        }




        @if (Model.Formulario &&
             rolId == "1")
        {
            <div>

                <h3>
                    Repuesto
                </h3>


  

                <label>
                    Imagen
                </label>

                <br />


                @if (!string.IsNullOrEmpty(
                    Model.Actual?.Imagen))
                {
                    <img height="100"
                         width="100"
                         style="object-fit:cover;"
                         src="data:image;base64,@Model.Actual.Imagen" />

                    <br />
                    <br />
                }


                <input type="file"
                       class="form-control"
                       asp-for="FormFile"
                       accept="image/*" />

                <br />




                <label>
                    Nombre Repuesto
                </label>

                <input id="nmNombre_Repuesto"
                       class="form-control"
                       asp-for="@Model.Actual!.Nombre_Repuesto" />

                <br />


                <label>
                    Descripción
                </label>

                <input id="nmDescripcion"
                       class="form-control"
                       asp-for="@Model.Actual!.Descripcion" />

                <br />


        

                <label>
                    Precio Compra
                </label>

                <input id="nmPrecio_Compra"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       asp-for="@Model.Actual!.Precio_Compra" />

                <br />


                <label>
                    Precio Venta
                </label>

                <input id="nmPrecio_Venta"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       asp-for="@Model.Actual!.Precio_Venta" />

                <br />



                <label>
                    Stock
                </label>

                <input id="nmStock"
                       type="number"
                       min="0"
                       class="form-control"
                       asp-for="@Model.Actual!.Stock" />

                <br />


                <label>
                    Stock Mínimo
                </label>

                <input id="nmStock_Minimo"
                       type="number"
                       min="0"
                       class="form-control"
                       asp-for="@Model.Actual!.Stock_Minimo" />

                <br />

            </div>
        }

        @if (Model.Borrar &&
             rolId == "1")
        {
            <div class="popup">

                <div class="pp_del_inner">

                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Desea borrar el repuesto?
                    </h4>

                    <h6>
                        @Model.Actual?.Nombre_Repuesto
                    </h6>


                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />


                    <input type="submit"
                           value="Borrar"
                           class="btn btn-danger"
                           asp-page-handler="BtBorrar" />

                </div>

            </div>
        }



        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default"
                 style="overflow-x:auto">

                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>

                        <th>
                            Imagen
                        </th>

                        <th>
                            Nombre Repuesto
                        </th>

                        <th>
                            Descripción
                        </th>

                        <th>
                            Precio Compra
                        </th>

                        <th>
                            Precio Venta
                        </th>

                        <th>
                            Stock
                        </th>

                        <th>
                            Stock Mínimo
                        </th>


                        @if (rolId == "1")
                        {
                            <th>
                                Acción
                            </th>
                        }

                    </tr>


                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>


                                <td>

                                    @if (!string.IsNullOrEmpty(
                                        elemento.Imagen))
                                    {
                                        <img height="60"
                                             width="60"
                                             style="object-fit:cover;"
                                             src="data:image;base64,@elemento.Imagen" />
                                    }

                                </td>


                                <td>
                                    @elemento.Nombre_Repuesto
                                </td>


                                <td>
                                    @elemento.Descripcion
                                </td>


                                <td>
                                    @elemento.Precio_Compra
                                </td>


                                <td>
                                    @elemento.Precio_Venta
                                </td>


                                <td>
                                    @elemento.Stock
                                </td>


                                <td>
                                    @elemento.Stock_Minimo
                                </td>


                                @if (rolId == "1")
                                {
                                    <td>

                                        <input type="submit"
                                               value="Editar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.Id" />


                                        <input type="submit"
                                               value="Borrar"
                                               class="btn btn-danger"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.Id" />

                                    </td>
                                }

                            </tr>
                        }
                    }

                </table>

            </div>
        }

    </div>

</form>