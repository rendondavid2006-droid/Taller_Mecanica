@page
@model ProveedoresModel
@{
    ViewData["Title"] = "Proveedores";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Proveedores</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flNombre" 
            placeholder="Nombre"
               asp-for="@Model.Filtro!.Nombre_Proveedor" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
          @await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Proveedor</h3>
                
                <label>
                    Nit
                </label>
                <input id="nmNit"
                    asp-for="@Model.Actual!.Nit" />
                <br/>

                <label>
                    Nombre Proveedor
                </label>
                <input id="nmNombre_Proveedor"
                    asp-for="@Model.Actual!.Nombre_Proveedor" />
                <br />

                <label>
                    Telefono
                </label>
                <input id="nmTelefono"
                    asp-for="@Model.Actual!.Telefono" />
                <br />

                <label>
                    Correo
                </label>
                <input id="nmCorreo"
                       asp-for="@Model.Actual!.Correo" />
                <br />

                <label>
                    Direccion
                </label>
                <input id="nmDireccion"
                       asp-for="@Model.Actual!.Direccion" />
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Nit,
                        @Model.Actual!.Nombre_Proveedor,
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nit</th>
                        <th>Nombre Proveedor</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>Direccion</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Nit</td>
                                <td>@elemento.Nombre_Proveedor</td>
                                <td>@elemento.Telefono</td>
                                <td>@elemento.Correo</td>
                                <td>@elemento.Direccion</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>