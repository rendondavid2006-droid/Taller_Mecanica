                                <li class="sidebar-item @(EsPagina("/Ventanas/Inventario/Compras") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Inventario/Compras">
                                        <i class="iconly-boldBuy"></i>
                                        <span>Compras</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Inventario/Detalles_Compras") ? "active" : "")">
