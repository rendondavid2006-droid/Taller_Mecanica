                                        <span>Usuarios Clientes</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Administracion/Roles") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Administracion/Roles">
                                        <i class="iconly-boldShield-Done"></i>
                                        <span>Roles</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Administracion/Permisos") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Administracion/Permisos">
                                        <i class="iconly-boldLock"></i>
                                        <span>Permisos</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Administracion/Auditorias") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Administracion/Auditorias">
                                        <i class="iconly-boldChart"></i>
                                        <span>Auditorías</span>
                                    </a>
                                </li>
                            }



                            @if (rolId == "2")
                            {
                                <li class="sidebar-title">
                                    Operación
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/VehiculosClientes/Vehiculos") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/VehiculosClientes/Vehiculos">
                                        <i class="iconly-boldDiscovery"></i>
                                        <span>Vehículos</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Citas") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Citas">
                                        <i class="iconly-boldCalendar"></i>
                                        <span>Citas</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Ordenes_Servicios") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Ordenes_Servicios">
                                        <i class="iconly-boldDocument"></i>
                                        <span>Órdenes</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Diagnosticos") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Diagnosticos">
                                        <i class="iconly-boldSearch"></i>
                                        <span>Diagnósticos</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Servicios") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Servicios">
                                        <i class="iconly-boldWork"></i>
                                        <span>Servicios</span>
                                    </a>
                                </li>

                                <li class="sidebar-title">
                                    Inventario
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Inventario/Repuestos") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Inventario/Repuestos">
                                        <i class="iconly-boldBag"></i>
                                        <span>Repuestos</span>
                                    </a>
                                </li>
                            }



                            @if (rolId == "3")
                            {
                                <li class="sidebar-title">
                                    Mi gestión
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Citas") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Citas">
                                        <i class="iconly-boldCalendar"></i>
                                        <span>Citas</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/VehiculosClientes/Vehiculos") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/VehiculosClientes/Vehiculos">
                                        <i class="iconly-boldDiscovery"></i>
                                        <span>Vehículos</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Servicios") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Servicios">
                                        <i class="iconly-boldWork"></i>
                                        <span>Servicios</span>
                                    </a>
                                </li>
