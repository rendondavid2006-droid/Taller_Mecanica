                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Citas") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Citas">
                                        <i class="iconly-boldCalendar"></i>
                                        <span>Citas</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Estados_Citas") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Taller/Estados_Citas">
                                        <i class="iconly-boldTick-Square"></i>
                                        <span>Estados Citas</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Taller/Horarios_Citas") ? "active" : "")">
