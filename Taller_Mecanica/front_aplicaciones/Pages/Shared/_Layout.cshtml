                        </ul>

                    </div>

                </div>

            </div>


            <div id="main">

                <header class="tm-topbar">

                    <div class="tm-topbar-left">

                        <button type="button"
                                class="burger-btn"
                                aria-label="Abrir menú">
                            <span class="tm-burger-lines"></span>
                        </button>

                        <div class="tm-topbar-title">
                            <span>@(ViewData["Title"] ?? "Taller Mecánica")</span>
                            <small>Panel de gestión</small>
                        </div>

                    </div>


                    <div class="tm-topbar-user">

                        <span class="tm-user-avatar">
                            @inicialUsuario
                        </span>

                        <div class="tm-user-copy">
                            <strong>@usuario</strong>
                            <small>@(rolNombre ?? "Usuario")</small>
                        </div>

                        <form method="post"
                              asp-area=""
                              asp-page="/Index"
                              asp-page-handler="BtClose"
                              class="tm-logout-form">

                            <button type="submit"
                                    class="tm-logout-btn"
                                    title="Cerrar sesión"
                                    aria-label="Cerrar sesión">
                                <i class="iconly-boldLogout"></i>
                            </button>

                        </form>

                    </div>

                </header>


                <div class="tm-main-content">

                    <main role="main">
                        @RenderBody()
                    </main>

                </div>


                <footer class="tm-footer">
                    &copy; 2026 - Taller Mecánica
                </footer>

            </div>

        </div>


        <script src="~/lib/jquery/dist/js/jquery.min.js"></script>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script src="~/js/site.js"
                asp-append-version="true"></script>

        <script src="~/mazer/js/mazer-layout.js"
                asp-append-version="true"></script>

        <script src="~/js/tm-uiverse.js"
                asp-append-version="true"></script>

        @await RenderSectionAsync(
            "Scripts",
            required: false)

    </body>
}
else
{
    <body class="tm-public">

        <header class="tm-public-header">

            <a class="tm-brand tm-public-brand"
               asp-area=""
               asp-page="/Index">

                <span class="tm-brand-mark">
                    <i class="iconly-boldSetting"></i>
                </span>

                <span class="tm-brand-copy">
                    <strong>Taller Mecánica</strong>
                    <small>Sistema administrativo</small>
                </span>

            </a>

        </header>


        <div class="tm-public-main">

            <main role="main">
                @RenderBody()
            </main>

        </div>


        <script src="~/lib/jquery/dist/js/jquery.min.js"></script>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script src="~/js/site.js"
                asp-append-version="true"></script>

        <script src="~/js/tm-uiverse.js"
                asp-append-version="true"></script>

        @await RenderSectionAsync(
            "Scripts",
            required: false)

    </body>
}

</html>
