                                <li class="sidebar-item @(EsPagina("/Ventanas/Inventario/Detalles_Repuestos_Ordenes") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Inventario/Detalles_Repuestos_Ordenes">
                                        <i class="iconly-boldPaper-Plus"></i>
                                        <span>Repuestos Órdenes</span>
                                    </a>
                                </li>


                                <li class="sidebar-title">
                                    Facturación
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Facturacion/Facturas") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Facturacion/Facturas">
                                        <i class="iconly-boldTicket"></i>
                                        <span>Facturas</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Facturacion/Pagos") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Facturacion/Pagos">
                                        <i class="iconly-boldWallet"></i>
                                        <span>Pagos</span>
                                    </a>
                                </li>


                                <li class="sidebar-title">
                                    Administración
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Administracion/Empleados") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Administracion/Empleados">
                                        <i class="iconly-boldWork"></i>
                                        <span>Empleados</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Administracion/Usuarios") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Administracion/Usuarios">
                                        <i class="iconly-boldUser"></i>
                                        <span>Usuarios</span>
                                    </a>
                                </li>

                                <li class="sidebar-item @(EsPagina("/Ventanas/Administracion/Usuarios_Clientes") ? "active" : "")">
                                    <a class="sidebar-link"
                                       asp-page="/Ventanas/Administracion/Usuarios_Clientes">
