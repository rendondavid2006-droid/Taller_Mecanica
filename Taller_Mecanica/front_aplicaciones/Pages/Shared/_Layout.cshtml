@using Microsoft.AspNetCore.Http

@{
    var usuario = Context.Session.GetString("Usuario");
    var rolId = Context.Session.GetString("RolId");
    var rolNombre = Context.Session.GetString("Rol");
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var inicialUsuario = !string.IsNullOrEmpty(usuario)
        ? usuario.Substring(0, 1).ToUpperInvariant()
        : "U";

    bool EsPagina(string pagina)
    {
        return string.Equals(
            paginaActual,
            pagina,
            StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Taller Mecánica</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/front_aplicaciones.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/mazer/css/iconly.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/mazer/css/mazer-taller.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tm-uiverse.css"
          asp-append-version="true" />
</head>

@if (!string.IsNullOrEmpty(usuario))
{
